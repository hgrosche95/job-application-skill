PORT=3000

# --- Auth ---
# AUTH_PASSWORD_HASH mit bcrypt erzeugen, z.B.:
# node -e "console.log(require('bcrypt').hashSync('dein-passwort', 10))"
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
JWT_SECRET=

# --- Scripts (bewerbungshelfer/scripts) ---
PYTHON_BIN=python

# Lokale Default-Pfade fuer Entwicklung/Tests - APPLICATIONS_DIR bewusst NICHT
# auf den echten Bewerbungen-Ordner gesetzt. Fuer echten Gebrauch hier den
# tatsaechlichen Pfad eintragen, z.B. C:/Users/<du>/Programme/Bewerbungen
RESUMES_DIR=./data/resumes
APPLICATIONS_DIR=./data/Bewerbungen

# --- LLM-Provider ---
# groq (Standard, kostenlos) oder anthropic
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys), OpenAI-kompatible Schnittstelle, Free Tier
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic (https://console.anthropic.com/settings/keys), nur nötig wenn LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
